{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "spacing": {
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "name": "Primary",
                    "color": "#1e73be"
                },
                {
                    "slug": "secondary",
                    "name": "Secondary",
                    "color": "#222222"
                },
                {
                    "slug": "background",
                    "name": "Background",
                    "color": "#ffffff"
                },
                {
                    "slug": "foreground",
                    "name": "Foreground",
                    "color": "#222222"
                },
                {
                    "slug": "muted",
                    "name": "Muted",
                    "color": "#666666"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
                    "name": "System Font",
                    "slug": "system-font"
                }
            ]
        },
        "layout": {
            "contentSize": "840px",
            "wideSize": "1100px"
        }
    },
    "styles": {
        "spacing": {
            "blockGap": "1.5rem"
        }
    }
}
